# Environment Configuration Template for SwasthyaSetu AI

ENVIRONMENT=development
SECRET_KEY=swasthya-setu-ai-super-secret-key-change-in-production-2026

# Backend Database
# Dev: sqlite:///./swasthya_setu.db
# Prod: postgresql://swasthya_user:swasthya_password@localhost:5432/swasthya_db
DATABASE_URL=sqlite:///./swasthya_setu.db

# AI Provider Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Guideline Default: "india_nhm" or "who"
DEFAULT_TRIAGE_GUIDELINE=india_nhm

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
